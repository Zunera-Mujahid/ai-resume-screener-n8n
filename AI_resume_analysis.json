    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "\n{\n  \"name\": \"resume_screening_evaluation\",\n  \"description\": \"Analyzes a candidate's resume against a job description and outputs strengths, weaknesses, risk/reward assessment, and an overall fit score.\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"candidate_strengths\": {\n      \"type\": \"array\",\n      \"description\": \"A list of specific strengths or qualifications that match the job description.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"candidate_weaknesses\": {\n      \"type\": \"array\",\n      \"description\": \"A list of areas where the candidate falls short or lacks alignment with the job requirements.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"risk_factor\": {\n      \"type\": \"object\",\n      \"description\": \"An evaluation of potential hiring risks based only on evidence in the resume and job description.\",\n      \"properties\": {\n        \"score\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"Low\",\n            \"Medium\",\n            \"High\"\n          ],\n          \"description\": \"The risk level associated with the candidate's documented skill gaps and hiring uncertainties.\"\n        },\n        \"explanation\": {\n          \"type\": \"string\",\n          \"description\": \"A brief, evidence-based explanation of potential hiring risks. Do not speculate about personal traits or unsupported worst-case scenarios.\"\n        }\n      },\n      \"required\": [\n        \"score\",\n        \"explanation\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"reward_factor\": {\n      \"type\": \"object\",\n      \"description\": \"An evaluation of the potential professional value of hiring this candidate.\",\n      \"properties\": {\n        \"score\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"Low\",\n            \"Medium\",\n            \"High\"\n          ],\n          \"description\": \"The potential value of the candidate based on documented skills and job alignment.\"\n        },\n        \"explanation\": {\n          \"type\": \"string\",\n          \"description\": \"A description of the candidate's potential contributions and whether their documented qualifications suggest short-term or long-term alignment.\"\n        }\n      },\n      \"required\": [\n        \"score\",\n        \"explanation\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"overall_fit_rating\": {\n      \"type\": \"integer\",\n      \"description\": \"A rating from 0 to 10 indicating how closely the candidate's documented qualifications match the job description. This is not a hiring decision.\",\n      \"minimum\": 0,\n      \"maximum\": 10\n    },\n    \"justification_for_rating\": {\n      \"type\": \"string\",\n      \"description\": \"A concise, evidence-based explanation of the fit rating, referencing specific matches and gaps between the resume and job description.\"\n    }\n  },\n  \"required\": [\n    \"candidate_strengths\",\n    \"candidate_weaknesses\",\n    \"risk_factor\",\n    \"reward_factor\",\n    \"overall_fit_rating\",\n    \"justification_for_rating\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
